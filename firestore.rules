rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function operationalV2(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('operational_v2', false) == true;
    }

    function clinicalV3(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('clinical_v3', false) == true;
    }
    function clinicAllowsArtifactSharing(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('share_clinical_artifacts_with_patients',false) == true;
    }

    function responsibleClinician(clinicId) {
      return moduleAvailable('clinical') && hasClinicRole(clinicId, ['doctor','Doctor','physician']);
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function globalRole() {
      return signedIn() ? profile().get('role', '') : '';
    }

    function clinicRole(clinicId) {
      return signedIn()
        ? profile().get('clinic_roles', {}).get(clinicId, globalRole())
        : '';
    }

    function clinicRoles(clinicId) {
      return signedIn()
        ? profile().get('clinic_role_lists', {}).get(clinicId, [clinicRole(clinicId)])
        : [];
    }

    function clinicIsActive(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('active', true) == true;
    }

    function isPlatformOwner() {
      return globalRole() in ['platform_owner', 'super_admin', 'owner'];
    }

    function moduleAvailable(moduleId) {
      return isPlatformOwner() ||
        !exists(/databases/$(database)/documents/platform_settings/modules) ||
        !(moduleId in get(/databases/$(database)/documents/platform_settings/modules).data.get('disabled_modules', []));
    }

    function clinicAllowsPrescriptionSharing(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data
        .get('share_prescriptions_with_patients', false) == true;
    }

    function isDirectClinicAdmin(clinicId) {
      return hasClinicRole(clinicId, [
        'admin', 'Admin', 'administrator', 'clinic_admin', 'branch_manager'
      ]);
    }

    function isActiveClinicAdmin() {
      return isDirectClinicAdmin(profile().get('active_clinic_id', ''));
    }

    function belongsTo(clinicId) {
      return signedIn() && (
        isPlatformOwner() ||
        (profile().get('status', 'approved') == 'approved' && clinicIsActive(clinicId) && (
          clinicId in profile().get('clinic_ids', []) ||
          (clinicId == 'default-clinic' && profile().get('clinic_ids', []).size() == 0)
        ))
      );
    }

    function hasClinicRole(clinicId, roles) {
      return belongsTo(clinicId) && clinicRoles(clinicId).hasAny(roles);
    }

    function isClinicAdmin(clinicId) {
      return isPlatformOwner() || hasClinicRole(clinicId, [
        'admin', 'Admin', 'administrator', 'clinic_admin',
        'branch_manager'
      ]);
    }

    function isClinical(clinicId) {
      return hasClinicRole(clinicId, [
        'doctor', 'Doctor', 'physician', 'vaccinator', 'nurse'
      ]);
    }

    function isReception(clinicId) {
      return hasClinicRole(clinicId, ['reception', 'receptionist']);
    }

    function isPharmacy(clinicId) {
      return hasClinicRole(clinicId, [
        'pharmacy_operator', 'Pharmacy Operator', 'pharmacy', 'pharmacist'
      ]);
    }

    function isAccounts(clinicId) {
      return hasClinicRole(clinicId, ['accountant', 'accounts']);
    }

    function validAppointment() {
      return request.resource.data.keys().hasAll([
        'patient_name', 'phone', 'scheduled_at', 'status', 'created_by'
      ]) &&
        request.resource.data.patient_name is string &&
        request.resource.data.phone is string &&
        request.resource.data.scheduled_at is timestamp &&
        request.resource.data.status in [
          'booked', 'cancelled', 'confirmed', 'completed'
        ];
    }

    function validReminderCreate() {
      return request.resource.data.keys().hasAll([
        'patient_name', 'message', 'scheduled_at', 'recipient', 'channel',
        'status', 'consent'
      ]) &&
        request.resource.data.patient_name is string &&
        request.resource.data.message is string &&
        request.resource.data.recipient is string &&
        request.resource.data.scheduled_at is timestamp &&
        request.resource.data.channel in ['sms', 'whatsapp', 'email'] &&
        request.resource.data.status == 'scheduled' &&
        request.resource.data.consent == true &&
        !request.resource.data.keys().hasAny([
          'attempts', 'provider', 'provider_message_id', 'provider_status',
          'sent_at', 'failure_reason', 'lease_expires_at', 'next_attempt_at'
        ]);
    }

    function validReminderUpdate() {
      return resource.data.status == 'scheduled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'patient_id', 'patient_name', 'type', 'message', 'scheduled_at',
        'recipient', 'channel', 'consent', 'template_id',
        'template_language', 'status', 'updated_at'
      ]) && request.resource.data.status in ['scheduled', 'cancelled'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId || isPlatformOwner() ||
        (isActiveClinicAdmin() &&
          resource.data.get('clinic_ids', []).hasAny(profile().get('clinic_ids', [])))
      );
      allow list: if signedIn() && (isPlatformOwner() ||
        (isActiveClinicAdmin() &&
          resource.data.get('clinic_ids', []).hasAny(profile().get('clinic_ids', []))));
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['clinic_admin', 'doctor', 'patient'] &&
        ((request.resource.data.role == 'patient' &&
          request.resource.data.status == 'approved') ||
         (request.resource.data.role in ['clinic_admin', 'doctor'] &&
          request.resource.data.status == 'pending')) &&
        request.resource.data.get('clinic_ids', []).size() == 0 &&
        request.resource.data.get('clinic_roles', {}).size() == 0 &&
        request.resource.data.get('clinic_role_lists', {}).size() == 0 &&
        request.resource.data.get('requested_clinic_name', '') is string;
      allow update: if signedIn() && (
        isPlatformOwner() ||
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('clinic_ids', []) == resource.data.get('clinic_ids', []) &&
          request.resource.data.get('clinic_roles', {}) == resource.data.get('clinic_roles', {}) &&
          request.resource.data.get('clinic_role_lists', {}) == resource.data.get('clinic_role_lists', {})) ||
        (request.auth.uid == userId && globalRole() == 'patient' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('clinic_ids', []).hasAll(resource.data.get('clinic_ids', [])) &&
          request.resource.data.get('clinic_ids', []).size() <=
            resource.data.get('clinic_ids', []).size() + 1 &&
          request.resource.data.get('active_clinic_id', '') in
            request.resource.data.get('clinic_ids', []) &&
          clinicIsActive(request.resource.data.get('active_clinic_id', '')) &&
          request.resource.data.get('clinic_roles', {}) == resource.data.get('clinic_roles', {}) &&
          request.resource.data.get('clinic_role_lists', {}) == resource.data.get('clinic_role_lists', {}) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clinic_ids', 'active_clinic_id', 'updated_at'
          ])) ||
        (isActiveClinicAdmin() &&
          resource.data.get('clinic_ids', []).hasAny(profile().get('clinic_ids', [])) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('clinic_ids', []) == resource.data.get('clinic_ids', []) &&
          request.resource.data.get('clinic_roles', {}).diff(
            resource.data.get('clinic_roles', {})
          ).affectedKeys().hasOnly(profile().get('clinic_ids', [])) &&
          request.resource.data.get('clinic_role_lists', {}).diff(
            resource.data.get('clinic_role_lists', {})
          ).affectedKeys().hasOnly(profile().get('clinic_ids', [])))
        || (isActiveClinicAdmin() &&
          resource.data.get('role', '') != 'platform_owner' &&
          resource.data.get('clinic_ids', []).hasAny(profile().get('clinic_ids', [])) &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.get('clinic_ids', []).hasOnly(
            resource.data.get('clinic_ids', [])
          ) &&
          request.resource.data.get('clinic_roles', {}).diff(
            resource.data.get('clinic_roles', {})
          ).affectedKeys().hasOnly(profile().get('clinic_ids', [])) &&
          request.resource.data.get('clinic_role_lists', {}).diff(
            resource.data.get('clinic_role_lists', {})
          ).affectedKeys().hasOnly(profile().get('clinic_ids', [])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clinic_ids', 'clinic_roles', 'clinic_role_lists',
            'active_clinic_id', 'updated_at'
          ]))
      );
      allow delete: if isPlatformOwner() && request.auth.uid != userId;
    }

    match /platform_settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isPlatformOwner();
      allow delete: if false;
    }

    function validNotificationTemplate(templateId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['event', 'channel', 'locale', 'enabled', 'subject', 'body',
        'msg91_template_id', 'twilio_template_id', 'revision', 'updated_at', 'updated_by']) &&
        data.event in ['password_reset', 'account_created', 'account_pending', 'account_approved',
          'member_invitation', 'member_approved', 'appointment_booked', 'appointment_confirmed',
          'appointment_rescheduled', 'appointment_cancelled', 'appointment_completed',
          'appointment_reminder', 'vaccination_reminder', 'follow_up_reminder', 'general_reminder',
          'invoice_created', 'payment_received'] &&
        data.channel in ['email', 'sms'] && data.locale in ['en', 'hi', 'gu'] &&
        templateId == data.event + '_' + data.channel + '_' + data.locale &&
        data.enabled is bool && data.subject is string && data.subject.size() <= 200 &&
        (data.channel != 'email' || data.subject.size() > 0) &&
        data.body is string && data.body.size() > 0 &&
        data.body.size() <= (data.channel == 'sms' ? 1600 : 10000) &&
        data.msg91_template_id is string && data.msg91_template_id.size() <= 200 &&
        data.twilio_template_id is string && data.twilio_template_id.size() <= 200 &&
        data.revision is int && data.updated_by == request.auth.uid && data.updated_at == request.time &&
        (data.event != 'password_reset' || data.channel != 'email' || data.enabled);
    }

    match /notification_templates/{templateId} {
      allow read: if isPlatformOwner();
      allow create: if isPlatformOwner() && validNotificationTemplate(templateId) && request.resource.data.revision == 1;
      allow update: if isPlatformOwner() && validNotificationTemplate(templateId) &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
      match /history/{revisionId} {
        allow read: if isPlatformOwner();
        allow create: if isPlatformOwner() && request.resource.data ==
          getAfter(/databases/$(database)/documents/notification_templates/$(templateId)).data;
        allow update, delete: if false;
      }
    }

    // Outbox entries may contain single-use reset links. They are server-only.
    match /notification_outbox/{jobId} { allow read, write: if false; }
    match /notification_rate_limits/{limitId} { allow read, write: if false; }

    match /clinic_name_keys/{keyId} {
      allow read, create, update, delete: if isPlatformOwner();
    }

    match /clinics/{clinicId} {
      allow read: if belongsTo(clinicId) ||
        (signedIn() && globalRole() == 'patient' &&
          resource.data.get('active', true) == true);
      allow create: if isPlatformOwner();
      allow update: if isPlatformOwner() ||
        (isDirectClinicAdmin(clinicId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'code', 'phone', 'address', 'currency', 'timezone',
            'opening_time', 'closing_time', 'working_days',
            'share_prescriptions_with_patients', 'share_clinical_artifacts_with_patients', 'updated_at'
          ]));
      allow delete: if isPlatformOwner();

      match /patients/{patientId} {
        allow read: if (moduleAvailable('patients') || moduleAvailable('reception') ||
          moduleAvailable('clinical')) &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) || isReception(clinicId));
        allow read: if signedIn() && globalRole() == 'patient' &&
          patientId == request.auth.uid && belongsTo(clinicId);
        allow create, update: if (moduleAvailable('patients') ||
          moduleAvailable('reception') || moduleAvailable('clinical')) &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) || isReception(clinicId));
        allow create, update: if signedIn() && globalRole() == 'patient' &&
          patientId == request.auth.uid && belongsTo(clinicId) &&
          request.resource.data.get('user_id', '') == request.auth.uid;
        allow delete: if (moduleAvailable('patients') || moduleAvailable('reception') ||
          moduleAvailable('clinical')) && isClinicAdmin(clinicId);
      }

      match /prescriptions/{prescriptionId} {
        allow read: if moduleAvailable('clinical') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) || isPharmacy(clinicId) ||
          (signedIn() && globalRole() == 'patient' &&
            resource.data.get('shared_with_patient', false) == true &&
            resource.data.get('patient_user_id', '') == request.auth.uid &&
            (resource.data.get('clinical_state','') != 'signed' || (belongsTo(clinicId) && clinicAllowsPrescriptionSharing(clinicId)))));
        allow create: if !clinicalV3(clinicId) && moduleAvailable('clinical') &&
          !request.resource.data.keys().hasAny(['clinical_state','clinical_version','clinical_author_id','signed_at']) &&
          (isClinicAdmin(clinicId) || isClinical(clinicId)) &&
          (request.resource.data.get('shared_with_patient', false) == false ||
            clinicAllowsPrescriptionSharing(clinicId));
        allow update: if moduleAvailable('clinical') && (
          (!clinicalV3(clinicId) && resource.data.get('clinical_state','') != 'signed' &&
            !request.resource.data.keys().hasAny(['clinical_state','clinical_version','clinical_author_id','signed_at']) &&
            (isClinicAdmin(clinicId) || isClinical(clinicId)) &&
            (request.resource.data.get('shared_with_patient', false) == false || clinicAllowsPrescriptionSharing(clinicId))) ||
          (resource.data.get('clinical_state','') == 'signed' &&
            (isPharmacy(clinicId) || responsibleClinician(clinicId)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated_at']) &&
            request.resource.data.status in ['pending','dispensed','completed'])
          || (resource.data.get('clinical_state','') == 'signed' && isClinicAdmin(clinicId) && !clinicAllowsPrescriptionSharing(clinicId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared_with_patient','updated_at']) && request.resource.data.shared_with_patient == false)
        );
        allow delete: if !clinicalV3(clinicId) && resource.data.get('clinical_state','') != 'signed' && moduleAvailable('clinical') && isClinicAdmin(clinicId);
      }

      match /clinical_encounters/{encounterId} {
        allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
        allow write: if false;
        match /versions/{version} {
          allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
          allow write: if false;
        }
      }
      match /clinical_encounter_private/{encounterId} {
        allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
        allow write: if false;
        match /versions/{version} {
          allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
          allow write: if false;
        }
      }
      match /clinical_receipts/{receiptId} {
        allow read: if responsibleClinician(clinicId) && resource.data.actor_id == request.auth.uid;
        allow write: if false;
      }
      match /clinical_releases/{releaseId} {
        allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
        allow write: if false;
      }
      match /clinical_release_revocations/{revocationId} {
        allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
        allow write: if false;
      }
      match /clinical_artifacts/{artifactId} {
        function owner() { return responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid; }
        allow read: if owner();
        allow write: if false;
        match /versions/{version} {
          allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
          allow write: if false;
        }
        match /release_history/{eventId} {
          allow read: if responsibleClinician(clinicId) && resource.data.author_id == request.auth.uid;
          allow write: if false;
        }
      }
      match /clinical_artifact_copies/{artifactId} {
        allow read: if (isClinicAdmin(clinicId) && !clinicAllowsArtifactSharing(clinicId)) || (moduleAvailable('clinical') && (
          (responsibleClinician(clinicId) && get(/databases/$(database)/documents/clinics/$(clinicId)/clinical_artifacts/$(artifactId)).data.author_id == request.auth.uid) ||
          (belongsTo(clinicId) && globalRole() == 'patient' && clinicAllowsArtifactSharing(clinicId) && resource.data.shared == true && resource.data.patient_user_id == request.auth.uid)));
        allow create, delete: if false;
        allow update: if isClinicAdmin(clinicId) && !clinicAllowsArtifactSharing(clinicId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared','updated_at']) && request.resource.data.shared == false;
      }
      match /clinical_artifact_receipts/{receiptId} {
        allow read: if responsibleClinician(clinicId) && resource.data.actor_id == request.auth.uid;
        allow write: if false;
      }
      match /clinical_order_keys/{keyId} { allow read, write: if false; }

      match /appointments/{appointmentId} {
        allow create: if !operationalV2(clinicId) && (moduleAvailable('appointments') || moduleAvailable('reception')) &&
          validAppointment() && (
          (belongsTo(clinicId) &&
            request.resource.data.created_by == request.auth.uid) ||
          (!signedIn() && clinicId == 'default-clinic' &&
            request.resource.data.created_by == '')
        );
        allow read: if (moduleAvailable('appointments') || moduleAvailable('reception')) &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) ||
          isReception(clinicId) ||
          (signedIn() && resource.data.created_by == request.auth.uid));
        allow update: if (!operationalV2(clinicId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated_at']) &&
            request.resource.data.status in ['cancelled','completed','no_show'] &&
            (request.resource.data.status != 'no_show' ||
              (resource.data.status in ['booked','pending'] && resource.data.get('arrival_at', null) == null &&
                resource.data.scheduled_at <= request.time)))) &&
          (moduleAvailable('appointments') || moduleAvailable('reception')) &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) ||
          isReception(clinicId) ||
          (signedIn() && resource.data.created_by == request.auth.uid &&
            request.resource.data.created_by == request.auth.uid &&
            request.resource.data.status in ['booked', 'cancelled']));
        allow delete: if !operationalV2(clinicId) && (moduleAvailable('appointments') || moduleAvailable('reception')) &&
          isClinicAdmin(clinicId);
      }

      match /practitioner_availability/{dayId} {
        allow read: if moduleAvailable('appointments') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) || isReception(clinicId));
        allow write: if false;
      }
      match /operational_receipts/{receiptId} {
        allow get: if belongsTo(clinicId) && resource.data.actor_id == request.auth.uid;
        allow list, write: if false;
      }
      match /operational_day_guards/{dayId} {
        allow read, write: if false;
      }

      match /stocks/{stockId} {
        allow read, create, update: if moduleAvailable('pharmacy') &&
          (isClinicAdmin(clinicId) || isPharmacy(clinicId));
        allow delete: if moduleAvailable('pharmacy') && isClinicAdmin(clinicId);
      }

      match /invoices/{invoiceId} {
        allow read: if (moduleAvailable('billing') || moduleAvailable('pharmacy')) &&
          (isClinicAdmin(clinicId) || isReception(clinicId) ||
          isPharmacy(clinicId) || isAccounts(clinicId));
        allow create, update: if (moduleAvailable('billing') || moduleAvailable('pharmacy')) &&
          (isClinicAdmin(clinicId) || isReception(clinicId) ||
          isPharmacy(clinicId) || isAccounts(clinicId));
        allow delete: if (moduleAvailable('billing') || moduleAvailable('pharmacy')) &&
          isClinicAdmin(clinicId);
      }

      match /finance_entries/{entryId} {
        allow read, create, update: if moduleAvailable('expenses') &&
          (isClinicAdmin(clinicId) || isAccounts(clinicId));
        allow delete: if moduleAvailable('expenses') && isClinicAdmin(clinicId);
      }

      match /vaccinations/{recordId} {
        allow read, create, update: if moduleAvailable('vaccination') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId));
        allow delete: if moduleAvailable('vaccination') && isClinicAdmin(clinicId);
      }

      match /reminders/{reminderId} {
        allow read: if moduleAvailable('reminders') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) || isReception(clinicId));
        allow create: if moduleAvailable('reminders') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) ||
          isReception(clinicId)) && validReminderCreate();
        allow update: if moduleAvailable('reminders') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId) ||
          isReception(clinicId)) && validReminderUpdate();
        allow delete: if moduleAvailable('reminders') && isClinicAdmin(clinicId);
      }

      match /audit_logs/{logId} {
        allow read: if isClinicAdmin(clinicId);
        allow create: if belongsTo(clinicId);
        allow update, delete: if false;
      }

      match /team_invites/{inviteId} {
        allow read, create: if isClinicAdmin(clinicId);
        allow update: if isPlatformOwner();
        allow delete: if isClinicAdmin(clinicId);
      }

      match /laboratory/{recordId} {
        allow read: if moduleAvailable('laboratory') &&
          (isClinicAdmin(clinicId) || isClinical(clinicId));
        allow create: if moduleAvailable('laboratory') && (isClinicAdmin(clinicId) || isClinical(clinicId)) &&
          !request.resource.data.keys().hasAny(['clinical_artifact_id','clinical_artifact_version','superseded']);
        allow update: if moduleAvailable('laboratory') && (isClinicAdmin(clinicId) || isClinical(clinicId)) &&
          !resource.data.keys().hasAny(['clinical_artifact_id']) && !request.resource.data.keys().hasAny(['clinical_artifact_id','clinical_artifact_version','superseded']);
        allow delete: if moduleAvailable('laboratory') && isClinicAdmin(clinicId) && !resource.data.keys().hasAny(['clinical_artifact_id']);
      }

      match /prescription_templates/{templateId} {
        allow read: if moduleAvailable('clinical') &&
          (isClinicAdmin(clinicId) || hasClinicRole(clinicId, ['doctor', 'Doctor', 'physician']));
        allow create, update: if moduleAvailable('clinical') &&
          (isClinicAdmin(clinicId) || hasClinicRole(clinicId, ['doctor', 'Doctor', 'physician'])) &&
          request.resource.data.keys().hasOnly(['name','diagnoses','complaints','investigation','advice','medicines','updated_at']) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
          request.resource.data.medicines is list && request.resource.data.medicines.size() <= 50;
        allow delete: if isClinicAdmin(clinicId);
      }
      match /settings/prescription_print {
        allow read: if moduleAvailable('clinical') && (isClinicAdmin(clinicId) || isClinical(clinicId) || isPharmacy(clinicId));
        allow create, update: if moduleAvailable('clinical') && isClinicAdmin(clinicId) &&
          request.resource.data.keys().hasOnly(['layout','clinician_name','qualifications','registration','footer_note','show_diagnoses','show_vitals','show_phone','font_size','margin_mm']) &&
          request.resource.data.layout in ['classic','minimal','bordered'] &&
          request.resource.data.clinician_name is string && request.resource.data.clinician_name.size() <= 160 &&
          request.resource.data.qualifications is string && request.resource.data.qualifications.size() <= 160 &&
          request.resource.data.registration is string && request.resource.data.registration.size() <= 160 &&
          request.resource.data.footer_note is string && request.resource.data.footer_note.size() <= 400 &&
          request.resource.data.show_diagnoses is bool && request.resource.data.show_vitals is bool && request.resource.data.show_phone is bool &&
          request.resource.data.font_size is number && request.resource.data.font_size >= 11 && request.resource.data.font_size <= 14 &&
          request.resource.data.margin_mm is number && request.resource.data.margin_mm >= 12 && request.resource.data.margin_mm <= 25;
        allow delete: if false;
      }
      match /clinical_notes/{prescriptionId} {
        allow read: if moduleAvailable('clinical') && (isClinicAdmin(clinicId) || hasClinicRole(clinicId,['doctor','Doctor','physician'])) &&
          (!exists(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)) ||
            get(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)).data.get('clinical_state','') != 'signed' || resource.data.author_id == request.auth.uid);
        allow create, update: if !clinicalV3(clinicId) &&
          (!exists(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)) ||
            get(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)).data.get('clinical_state','') != 'signed') &&
          moduleAvailable('clinical') && (isClinicAdmin(clinicId) || hasClinicRole(clinicId,['doctor','Doctor','physician'])) &&
          request.resource.data.keys().hasOnly(['patient_id','body','author_id','updated_at']) &&
          request.resource.data.author_id == request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() <= 20000;
        allow delete: if !clinicalV3(clinicId) &&
          (!exists(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)) ||
            get(/databases/$(database)/documents/clinics/$(clinicId)/prescriptions/$(prescriptionId)).data.get('clinical_state','') != 'signed') && isClinicAdmin(clinicId);
      }
      match /treatment_plans/{planId} {
        allow read: if moduleAvailable('clinical') &&
          (isClinicAdmin(clinicId) || hasClinicRole(clinicId, ['doctor', 'Doctor', 'physician']));
        allow create, update: if moduleAvailable('clinical') &&
          (isClinicAdmin(clinicId) || hasClinicRole(clinicId, ['doctor', 'Doctor', 'physician'])) &&
          request.resource.data.patient_id is string && request.resource.data.patient_id.size() > 0 &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.sittings is list && request.resource.data.sittings.size() <= 100 &&
          request.resource.data.get('status','active') in ['active','completed','cancelled'];
        allow delete: if isClinicAdmin(clinicId);
        match /sitting_logs/{logId} {
          function canTreat() { return moduleAvailable('clinical') && (isClinicAdmin(clinicId) || hasClinicRole(clinicId,['doctor','Doctor','physician'])); }
          allow read: if canTreat();
          allow create: if canTreat() &&
            request.resource.data.keys().hasOnly(['sitting_index','work_done','notes','performed_at','author_id','recorded_at']) &&
            request.resource.data.sitting_index is int && request.resource.data.sitting_index >= 0 && request.resource.data.sitting_index < 100 &&
            logId == string(request.resource.data.sitting_index) &&
            request.resource.data.work_done is string && request.resource.data.work_done.size() > 0 && request.resource.data.work_done.size() <= 4000 &&
            request.resource.data.notes is string && request.resource.data.notes.size() <= 10000 &&
            request.resource.data.performed_at is timestamp && request.resource.data.recorded_at == request.time &&
            request.resource.data.author_id == request.auth.uid &&
            get(/databases/$(database)/documents/clinics/$(clinicId)/treatment_plans/$(planId)).data.get('status','active') == 'active' &&
            get(/databases/$(database)/documents/clinics/$(clinicId)/treatment_plans/$(planId)).data.sittings[request.resource.data.sitting_index].completed == false &&
            getAfter(/databases/$(database)/documents/clinics/$(clinicId)/treatment_plans/$(planId)).data.sittings[request.resource.data.sitting_index].completed == true;
          allow update, delete: if false;
        }
      }
      match /staff_messages/{messageId} {
        function staffMember() { return isClinicAdmin(clinicId) || hasClinicRole(clinicId,
          ['doctor','Doctor','physician','reception','receptionist','vaccinator','nurse','pharmacy_operator','pharmacist','accountant','accounts']); }
        allow read: if staffMember();
        allow create: if staffMember() && request.resource.data.keys().hasOnly(['text','sender_name','sender_id','sent_at']) &&
          request.resource.data.sender_id == request.auth.uid && request.resource.data.sent_at == request.time &&
          request.resource.data.sender_name is string && request.resource.data.sender_name.size() <= 160 &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // Collection-group queries cannot rely on a fixed clinic ancestor.
    // This grants only owner list access; deletes still use clinic-scoped rules.
    match /{parent=**}/{moduleCollection}/{recordId} {
      allow list: if isPlatformOwner() && moduleCollection in [
        'patients', 'prescriptions', 'appointments', 'stocks',
        'finance_entries', 'invoices', 'vaccinations', 'reminders',
        'laboratory', 'team_invites'
      ];
    }

    // Legacy top-level clinical collections are intentionally read-only for
    // platform owners while data is migrated into /clinics/{clinicId}/....
    match /{legacyCollection}/{documentId} {
      allow read: if isPlatformOwner() && legacyCollection in [
        'patients', 'prescriptions', 'appointments', 'stocks', 'finance_entries'
      ];
      allow write: if false;
    }
  }
}
