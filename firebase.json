          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "clinical-solution-5dc1d",
          "appId": "1:715512178126:ios:aff8b81cab43a12382779f",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "clinical-solution-5dc1d",
          "appId": "1:715512178126:ios:aff8b81cab43a12382779f",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "clinical-solution-5dc1d",
          "configurations": {
            "android": "1:715512178126:android:cf70974901bb38d482779f",
            "ios": "1:715512178126:ios:aff8b81cab43a12382779f",
            "macos": "1:715512178126:ios:aff8b81cab43a12382779f",
            "web": "1:715512178126:web:5dab01024cf9dbca82779f",
            "windows": "1:715512178126:web:b59b3054282df88e82779f"
          }
        }
      }
